#!/usr/bin/env bash
# Run straight from a clone, without installing.
#   pip install -e .   is the better route — this is the no-install fallback.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec python3 -c 'import sys; from agent_pipeline.cli import main; sys.exit(main())' "$@"
